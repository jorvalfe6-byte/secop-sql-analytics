/// Proveedores ordenados de mayor a menor valor, en 100 grupos iguales (año completo).
table 'Pareto proveedores'
	lineageTag: 7bf4d937-d167-6bb9-43de-a329b5d2af60

	measure '% valor acumulado (proveedores)' = MAX('Pareto proveedores'[valor_acumulado_pct])
		formatString: 0.0%
		lineageTag: 978f81bf-7ea8-4d78-3f2c-627a8c22a6c5

	column Percentil
		dataType: int64
		formatString: 0
		lineageTag: 3e7b7b91-fbf9-0c4a-0f06-23ac717257e9
		summarizeBy: none
		sourceColumn: percentil

		annotation SummarizationSetBy = Automatic

	column proveedores
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ad4fc927-a0e9-b3ec-f8b4-b2d50f710725
		summarizeBy: none
		sourceColumn: proveedores

		annotation SummarizationSetBy = Automatic

	column valor
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 478ec37c-64d1-47cc-06ab-fdbd68915769
		summarizeBy: none
		sourceColumn: valor

		annotation SummarizationSetBy = Automatic

	column valor_acumulado_pct
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 86eea19a-fbea-294d-8f75-bcc2f40473ac
		summarizeBy: none
		sourceColumn: valor_acumulado_pct

		annotation SummarizationSetBy = Automatic

	partition 'Pareto proveedores' = m
		mode: import
		source =
				let
				    Archivo = "pareto_proveedores.csv",
				    Binario = if Text.StartsWith(DataPath, "http")
				        then Web.Contents(DataPath, [RelativePath = Archivo])
				        else File.Contents(DataPath & Archivo),
				    Fuente = Csv.Document(Binario, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"percentil", Int64.Type}, {"proveedores", Int64.Type}, {"valor", type number}, {"valor_acumulado_pct", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
