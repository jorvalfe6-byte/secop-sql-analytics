table 'Tipo de persona'
	lineageTag: 7024d1c0-dcfe-c805-9bf0-e34f4b7ecfce

	column 'Tipo de persona'
		dataType: string
		lineageTag: d0c775f5-f3fa-a1a4-5583-8a277b26c362
		summarizeBy: none
		sourceColumn: tipo_persona

		annotation SummarizationSetBy = Automatic

	partition 'Tipo de persona' = m
		mode: import
		source =
				let
				    Archivo = "dim_tipo_persona.csv",
				    Binario = if Text.StartsWith(DataPath, "http")
				        then Web.Contents(DataPath, [RelativePath = Archivo])
				        else File.Contents(DataPath & Archivo),
				    Fuente = Csv.Document(Binario, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"tipo_persona", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
