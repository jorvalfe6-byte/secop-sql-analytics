		annotation SummarizationSetBy = Automatic

	partition Contratos = m
		mode: import
		source =
				let
				    Archivo = "fact_mensual.csv",
				    Binario = if Text.StartsWith(DataPath, "http")
				        then Web.Contents(DataPath, [RelativePath = Archivo])
				        else File.Contents(DataPath & Archivo),
				    Fuente = Csv.Document(Binario, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"mes", type date}, {"entidad_key", Int64.Type}, {"modalidad_key", Int64.Type}, {"tipo_persona", type text}, {"contratos", Int64.Type}, {"contratos_validos", Int64.Type}, {"valor", type number}, {"valor_pagado", type number}, {"contratos_sin_pago", Int64.Type}, {"contratos_con_adicion", Int64.Type}, {"dias_adicionados", Int64.Type}, {"contratos_con_duracion", Int64.Type}, {"duracion_dias_suma", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
