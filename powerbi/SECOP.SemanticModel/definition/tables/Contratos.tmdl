		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: 32f7e328-bf6b-e06b-46db-e3099b3ac31e
		summarizeBy: none
		sourceColumn: valor_pagado

		annotation SummarizationSetBy = Automatic

