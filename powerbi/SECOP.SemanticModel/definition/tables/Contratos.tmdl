/// Contratos firmados en 2024, agregados por mes x entidad x modalidad x tipo de persona.
table Contratos
	lineageTag: 48aaa688-86f5-3cc6-0982-0ea5ca47855a

	/// Todos los contratos, incluidos los que no pasan los controles de valor.
	measure 'Contratos firmados' = SUM(Contratos[contratos])
		formatString: #,0
		lineageTag: ee45ee7e-b003-fff9-9164-6d9467312629

	/// Valor entre $ 1.000 y menos de $ 1 billón, sin repetidos.
	measure 'Contratos válidos' = SUM(Contratos[contratos_validos])
		formatString: #,0
		lineageTag: 900f321a-d356-4a4e-57a7-860b00517945

	/// Suma del valor de los contratos válidos, en pesos.
	measure 'Valor contratado' = SUM(Contratos[valor])
		formatString: "$ "#,0
		lineageTag: 41f7d40e-e9ff-40a8-883c-16ae3359a391

	measure 'Valor (billones)' = DIVIDE([Valor contratado], 1000000000000)
		formatString: #,0.0
		lineageTag: 08a9fddf-cb3c-c1ba-1207-32bb6c8e9c4d

	/// Promedio, muy por encima de la mediana (18 millones) por la cola de contratos grandes.
	measure 'Valor promedio (millones)' = DIVIDE([Valor contratado], [Contratos válidos]) / 1000000
		formatString: #,0.0
		lineageTag: 65f25707-bbb8-f6b4-6e53-a7fb78709bc8

	measure '% del valor' = DIVIDE([Valor contratado], CALCULATE([Valor contratado], ALLSELECTED()))
		formatString: 0.0%
		lineageTag: 6cbb583e-9656-4fc5-793a-c91a6cd2e619

	measure '% de los contratos' = DIVIDE([Contratos válidos], CALCULATE([Contratos válidos], ALLSELECTED()))
		formatString: 0.0%
		lineageTag: 1b9305d8-773a-c988-b7a4-c1b267f77fd6

	/// Pagado según SECOP, topado en el valor de cada contrato.
	measure '% del valor pagado' = DIVIDE(SUM(Contratos[valor_pagado]), [Valor contratado])
		formatString: 0.0%
		lineageTag: 91604a30-f5ca-65c3-c3c2-7e3956eae180

	measure '% sin ningún pago' = DIVIDE(SUM(Contratos[contratos_sin_pago]), [Contratos válidos])
		formatString: 0.0%
		lineageTag: 922772fc-81bf-b3f1-225c-56e4284a4b4f

	measure '% con días adicionados' = DIVIDE(SUM(Contratos[contratos_con_adicion]), [Contratos válidos])
		formatString: 0.0%
		lineageTag: baad67f0-b815-8df6-fdf9-2d722f605a15

	measure 'Duración promedio (días)' = DIVIDE(SUM(Contratos[duracion_dias_suma]), SUM(Contratos[contratos_con_duracion]))
		formatString: #,0
		lineageTag: f0f1ff38-7855-3ec6-0bf5-8e94a552144b

	/// Pareto: participación acumulada de las entidades ordenadas de mayor a menor valor.
	measure '% valor acumulado (entidades)' = ```
			VAR actual = [Valor contratado]
			VAR tabla =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(Entidad[entidad_key]), "@v", [Valor contratado]),
			        ALLSELECTED(Entidad)
			    )
			VAR acumulado = SUMX(FILTER(tabla, [@v] >= actual), [@v])
			RETURN DIVIDE(acumulado, SUMX(tabla, [@v]))
			```
		formatString: 0.0%
		lineageTag: f755a2de-f626-925a-630f-82b33aad9db8

	column mes
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: c3befe2f-7a31-3057-417f-2c9f983e5b1d
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column entidad_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3959e6d8-7602-ece2-b1ff-77d310ebc96e
		summarizeBy: none
		sourceColumn: entidad_key

		annotation SummarizationSetBy = Automatic

	column modalidad_key
